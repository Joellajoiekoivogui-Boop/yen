# =============================================================================
# YEN Career Bridge — variables d'environnement (EXEMPLE, aucune valeur réelle)
# Copier vers .env.local (développement) ou les définir dans l'hébergeur.
# =============================================================================

# --- Supabase (obligatoire) ---------------------------------------------------
# URL du projet et clé PUBLIQUE (« publishable »). L'ancienne clé « anon » est acceptée à la place :
# NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...
NEXT_PUBLIC_SUPABASE_URL=https://votre-projet.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxx
# Clé SECRÈTE (« secret » ou ancienne « service_role ») : serveur uniquement,
# ne JAMAIS la préfixer par NEXT_PUBLIC_ ni la committer.
# Facultative : seules les fonctions d'IA et la déconnexion forcée d'un compte l'utilisent.
SUPABASE_SECRET_KEY=sb_secret_xxxxxxxxxxxxxxxx

# URL publique de l'application (adresses de retour de Supabase Auth)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- E-mails d'authentification (code de vérification) -----------------------
# Envoyés par Supabase Auth via le SMTP de Resend : AUCUNE variable Resend ici.
# La clé Resend se saisit uniquement dans Supabase (Authentication › Emails › SMTP
# Settings), jamais dans le code ni dans un .env. Voir docs/EMAILS-RESEND.md.
# Facultatif (serveur) : délai avant de pouvoir redemander un code, en secondes ;
# à aligner sur l'intervalle minimal entre deux e-mails réglé dans Supabase.
# AUTH_RESEND_DELAY_S=60

# --- Intelligence artificielle (facultatif) -----------------------------------
# none = IA désactivée (la plateforme reste pleinement utilisable sans IA)
# anthropic = API Claude (clé serveur uniquement)
AI_PROVIDER=none
ANTHROPIC_API_KEY=
AI_MODEL=claude-opus-5-5
AI_TIMEOUT_MS=120000

# --- Antivirus des CV (facultatif) --------------------------------------------
# URL d'un service REST ClamAV renvoyant {"infected": bool, "viruses": [...]}.
# Vide = contrôle structurel des PDF uniquement (signalé « contrôle basique »).
CLAMAV_SCAN_URL=

# --- Notifications externes (non branchées : architecture prête) -------------
EMAIL_PROVIDER=none
SMS_PROVIDER=none
WHATSAPP_PROVIDER=none
