# =============================================================================
# YEN Career Bridge — variables d'environnement (EXEMPLE, aucune valeur réelle)
# Copier vers .env.local (développement) ou les définir dans l'hébergeur.
# =============================================================================

# --- Supabase (obligatoire) ---------------------------------------------------
# URL du projet et clé PUBLIQUE (« publishable » ou ancienne clé « anon »).
NEXT_PUBLIC_SUPABASE_URL=https://votre-projet.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxx
# Clé SECRÈTE (« secret » ou ancienne « service_role ») : serveur uniquement,
# ne JAMAIS la préfixer par NEXT_PUBLIC_ ni la committer.
# Facultative : seules les fonctions d'IA et la déconnexion forcée d'un compte l'utilisent.
SUPABASE_SECRET_KEY=sb_secret_xxxxxxxxxxxxxxxx

# URL publique de l'application (liens des e-mails de confirmation)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Intelligence artificielle (facultatif) -----------------------------------
# none = IA désactivée (la plateforme reste pleinement utilisable sans IA)
# anthropic = API Claude (clé serveur uniquement)
AI_PROVIDER=none
ANTHROPIC_API_KEY=
AI_MODEL=claude-opus-5-5
AI_TIMEOUT_MS=120000

# --- Antivirus des CV (facultatif) --------------------------------------------
# URL d'un service REST ClamAV renvoyant {"infected": bool, "viruses": [...]}.
# Vide = contrôle structurel des PDF uniquement (signalé « contrôle basique »).
CLAMAV_SCAN_URL=

# --- Notifications externes (non branchées : architecture prête) -------------
EMAIL_PROVIDER=none
SMS_PROVIDER=none
WHATSAPP_PROVIDER=none
